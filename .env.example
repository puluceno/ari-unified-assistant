# Azure OpenAI (Azure AI Foundry) deployment used by the hub.
AZURE_AI_CHAT_COMPLETIONS_URL=https://<resource>.openai.azure.com/openai/v1/chat/completions
AZURE_AI_API_KEY=
AZURE_AI_DEPLOYMENT=gpt-6-luna

# Local secrets. Generate each with: openssl rand -hex 24
HUB_API_KEY=
WEBUI_SECRET_KEY=
# Password for the Open WebUI admin (WEBUI_ADMIN_EMAIL in docker-compose.yml), created on first start.
WEBUI_ADMIN_PASSWORD=
